# Скопируйте в .env.local и заполните. Секреты остаются на сервере.

# Строка подключения к PostgreSQL (локальный, Supabase, Neon). Для пулера в transaction mode
# (в адресе есть "pooler" или "pgbouncer") prepared statements отключаются автоматически;
# принудительно: DB_PREPARE=false. Размер пула соединений: DB_POOL_MAX (по умолчанию 5; на serverless — 1–3).
DATABASE_URL=postgres://user:password@127.0.0.1:5432/zaprosto

# Адрес сайта без слэша в конце. Используется для metadataBase и проверки Origin у POST/DELETE.
APP_ORIGIN=http://localhost:3000

# Секрет (>= 32 символов), из него выводятся приватные ссылки заявок: HMAC-SHA256(TOKEN_SECRET, Idempotency-Key).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Меняйте только осознанно: после смены повтор отправки со старым ключом вернёт другую ссылку;
# уже выданные ссылки продолжают работать (в БД хранится только sha256 токена).
TOKEN_SECRET=

# Пароль владельца. Читается ТОЛЬКО скриптами db:seed и owner:password (в БД попадает scrypt-хеш).
OWNER_PASSWORD=

# Отдельная база для интеграционных тестов (npm test). Имя базы обязано заканчиваться на _test.
TEST_DATABASE_URL=postgres://user:password@127.0.0.1:5432/zaprosto_test

# Заголовок с IP клиента, который ставит платформа (для лимитов). Vercel: x-real-ip.
# Пусто — берётся самое правое значение X-Forwarded-For.
CLIENT_IP_HEADER=
